{
  "expo": {
    "name": "WOMBLY",
    "slug": "wombly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/4.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "sdkVersion": "54.0.0",
    "splash": {
      "image": "./assets/4.png",
      "resizeMode": "contain",
      "backgroundColor": "#f0cfe3"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "This app uses local network to stream videos",
        "NSBonjourServiceTypes": [
          "_http._tcp",
          "_https._tcp"
        ],
        "NSAllowsArbitraryLoadsInWebContent": true,
        "UIRequiredDeviceCapabilities": [
          "video-playback"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/4.png",
        "backgroundColor": "#de81fa"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/4.png"
    },
    "scheme": "wombly",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ]
  }
}
